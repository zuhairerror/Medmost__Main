# ==========================================================================
# MEDMOST - Environment Variables for Supabase Connection
# In Vercel: Project Settings > Environment Variables
# ==========================================================================

# 1. Supabase Project URL (Required)
# IMPORTANT: Must end in .supabase.co
# DO NOT append /rest/v1 or trailing slashes!
SUPABASE_URL=https://cyycbbzscvdojmdelutm.supabase.co

# 2. Supabase Anon / Public API Key
# Copy this from Supabase: Project Settings > API > Project API Keys > anon / public
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 3. (Recommended for Serverless) Supabase Service Role Key
# Copy this from Supabase: Project Settings > API > Project API Keys > service_role
# Because api/consultation.js runs ONLY on Vercel's server (never in the browser),
# this key safely bypasses Row Level Security for backend submissions.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here


